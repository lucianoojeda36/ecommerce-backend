# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_PUBLIC_KEY=your-mercadopago-public-key
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-signing-secret
MERCADOPAGO_WEBHOOK_BASE_URL=https://your-public-api-url.com

# OCA e-Pak (https://developers.oca.com.ar/epak.html)
# Datos entregados por OCA al activar el servicio e-Pak (ejecutivo de cuenta / portal corporativo).
# Para probar contra QA, OCA publica credenciales de prueba en su documentación:
#   OCA_CUIT=30-53625919-4  OCA_USER=test@oca.com.ar  OCA_PASSWORD=123456
#   OCA_ACCOUNT_NUMBER=111757/001
#   OCA_OPERATIVA_DOMICILIO=64665 (puerta a puerta)  OCA_OPERATIVA_SUCURSAL=62342 (puerta a sucursal)
# IMPORTANTE: en producción (.env.prod / variables del hosting) estas claves deben cargarse con
# los datos reales del contrato y OCA_ENV=prod - hoy faltan ahí, así que un deploy a prod cae
# silenciosamente al ambiente qa con credenciales vacías.
OCA_ENV=qa
OCA_CUIT=
OCA_USER=
OCA_PASSWORD=
OCA_ACCOUNT_NUMBER=
OCA_OPERATIVA_DOMICILIO=
OCA_OPERATIVA_SUCURSAL=

# Storage (local fallback for dev)
UPLOAD_DIR=uploads

# Frontend
FRONTEND_URL=http://localhost:5173

# Email (SMTP - Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail
SMTP_FROM=Mi Tienda <tu-email@gmail.com>
SMTP_CONTACT_TO=tu-email@gmail.com
